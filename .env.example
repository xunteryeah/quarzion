# Generate unique production values; never commit the real secrets.
GEO_PROOF_INGEST_KEY=replace-with-64-random-hex-characters
GEO_PROOF_INGEST_KEYS=
QUARZION_SCHEDULER_KEY=replace-with-64-random-hex-characters
QUARZION_AUDIT_SALT=replace-with-64-random-hex-characters
QUARZION_OUTBOX_ENCRYPTION_KEY=replace-with-64-random-hex-characters
QUARZION_DELIVERY_KEY=replace-with-64-random-hex-characters
QUARZION_APP_URL=https://app.quarzion.com

# Contact and invitation delivery are enabled in P0-07.
QUARZION_FROM_EMAIL=Quarzion <notifications@quarzion.com>
QUARZION_CONTACT_EMAIL=hello@quarzion.com
RESEND_API_KEY=

# Operations alerts and an off-server backup mount are required for P0 production.
QUARZION_ALERT_WEBHOOK_URL=
QUARZION_OFFSITE_DIR=

# P1 official API worker. Production model keys belong on the Shanghai worker,
# not on the Singapore control plane.
QUARZION_FRONTEND_IMAGE=quarzion-frontend:p1-latest
QUARZION_ADMIN_IMAGE=quarzion-admin:p1-latest
QUARZION_COLLECTOR_IMAGE=quarzion-collector:p1-latest
COLLECTOR_WORKER_ID=collector-cn-shanghai-01
COLLECTOR_LABEL=Shanghai official API worker
COLLECTOR_VERSION=2.0.0
COLLECTOR_POLL_MS=5000
COLLECTOR_PLATFORMS=doubao,qwen,deepseek

# Official model APIs. Secrets are server-only and must never use NEXT_PUBLIC_ names.
# Doubao Seed 2.1 models must also be activated in the Ark console before calls work.
DOUBAO_ARK_API_KEY=
DOUBAO_ARK_MODELS=doubao-seed-2-1-pro-260628,doubao-seed-2-1-turbo-260628
DASHSCOPE_API_KEY=
QWEN_MODELS=qwen3.8-max,qwen3.7-plus
DEEPSEEK_API_KEY=
DEEPSEEK_MODELS=deepseek-v4-pro,deepseek-v4-flash
