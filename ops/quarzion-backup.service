[Unit]
Description=WindCall protected production backup
After=docker.service
Requires=docker.service
OnFailure=quarzion-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/quarzion
EnvironmentFile=-/opt/quarzion/.env
ExecStart=/opt/quarzion/scripts/backup-production.sh
User=root
Group=root
Nice=10
